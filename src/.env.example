# 이더리움 메인넷 RPC (예: Alchemy)
NEXT_PUBLIC_RPC_MAINNET=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# BASE 세폴리아 테스트넷 RPC
NEXT_PUBLIC_RPC_SEPOLIA=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Base 메인넷 RPC
NEXT_PUBLIC_RPC_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Avalanche C-Chain RPC
NEXT_PUBLIC_RPC_AVALANCHE=https://avax-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Avalanche BNB-CHAIN RPC
NEXT_PUBLIC_RPC_BSC=https://bnb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

NEXT_PUBLIC_GOOGLE_AD_API_KEY="YOUR_GOOGLE_AD_API_KEY"

# 가스 대납 스폰서 지갑 주소 (check-tx 판정용, 공개 정보)
# NEXT_PUBLIC_SPONSOR_ADDRESS_AVALANCHE=0x...

# ───────── 광고 시청 검증 게이팅 (docs/AD-GATING.md 참고) ─────────
# 서버/클라이언트 둘 다 true로 켜야 동작 (둘 중 하나만 켜면 fail-closed로 막힘)
# AD_GATING_ENABLED=true
# NEXT_PUBLIC_AD_GATING_ENABLED=true

# Upstash Redis (Vercel Upstash 통합 시 KV_REST_API_* 자동 주입)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Cloudflare Turnstile (웹 best-effort 봇 방지). 둘 다 설정하거나 둘 다 비워둘 것.
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Capacitor 앱: MetaMask 연결용 WalletConnect Cloud Project ID
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# MetaMask SDK dApp URL
# NEXT_PUBLIC_APP_URL=https://ad-gas.vercel.app
# NEXT_PUBLIC_METAMASK_USE_DEEPLINK=false
